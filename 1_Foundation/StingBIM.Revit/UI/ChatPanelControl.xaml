<UserControl x:Class="StingBIM.Revit.UI.ChatPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <UserControl.Resources>
        <!-- Inline styles matching AITheme.xaml dark palette -->
        <SolidColorBrush x:Key="AccentBrush" Color="#4A90D9"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#6BA5E7"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#323233"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#252526"/>
        <SolidColorBrush x:Key="FgBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="FgSecondaryBrush" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#606060"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#404040"/>
        <SolidColorBrush x:Key="UserBubbleBrush" Color="#4A90D9"/>
        <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="ErrorBubbleBrush" Color="#3D2020"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Messages -->
            <RowDefinition Height="*"/>
            <!-- Quick actions -->
            <RowDefinition Height="Auto"/>
            <!-- Input -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- AI Icon -->
                <Grid Grid.Column="0" Width="32" Height="32">
                    <Ellipse Fill="{StaticResource AccentBrush}"/>
                    <TextBlock Text="AI" Foreground="White" FontWeight="Bold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Title -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="StingBIM AI Assistant" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource FgBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="11"
                               Foreground="{StaticResource FgSecondaryBrush}"/>
                </StackPanel>

                <!-- Clear button -->
                <Button Grid.Column="2" x:Name="ClearButton" Content="Clear"
                        Background="Transparent" Foreground="{StaticResource FgSecondaryBrush}"
                        BorderThickness="0" Padding="8,4" FontSize="11" Cursor="Hand"
                        Click="ClearButton_Click" ToolTip="Clear chat history"/>
            </Grid>
        </Border>

        <!-- Messages Area -->
        <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#1E1E1E">
            <StackPanel x:Name="MessagesPanel" Margin="8"/>
        </ScrollViewer>

        <!-- Quick Actions -->
        <Border Grid.Row="2" x:Name="QuickActionsPanel" Background="{StaticResource SurfaceBrush}"
                Padding="8,4" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Create -->
                    <WrapPanel Margin="0,2">
                        <TextBlock Text="Create:" FontSize="10" FontWeight="SemiBold" Width="52"
                                   Foreground="{StaticResource FgSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Wall 5m" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#66BB6A"
                                BorderBrush="#66BB6A" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="create wall 5m"/>
                        <Button Content="Bedroom 4x5" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#66BB6A"
                                BorderBrush="#66BB6A" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="create bedroom 4x5"/>
                        <Button Content="Floor 6x8" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#66BB6A"
                                BorderBrush="#66BB6A" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="create floor 6x8"/>
                        <Button Content="Kitchen" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#66BB6A"
                                BorderBrush="#66BB6A" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="create kitchen"/>
                    </WrapPanel>
                    <!-- Analyze -->
                    <WrapPanel Margin="0,2">
                        <TextBlock Text="Analyze:" FontSize="10" FontWeight="SemiBold" Width="52"
                                   Foreground="{StaticResource FgSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Compliance" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="check compliance IBC"/>
                        <Button Content="Materials" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="recommend material for walls"/>
                        <Button Content="QA Check" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="run quality check"/>
                        <Button Content="BOQ" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="create boq"/>
                    </WrapPanel>
                    <!-- Calculate -->
                    <WrapPanel Margin="0,2">
                        <TextBlock Text="Calc:" FontSize="10" FontWeight="SemiBold" Width="52"
                                   Foreground="{StaticResource FgSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Cable Size" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#FFA726"
                                BorderBrush="#FFA726" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="calculate cable size 240V 30A 50m"/>
                        <Button Content="Cooling Load" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#FFA726"
                                BorderBrush="#FFA726" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="calculate cooling load 100m2"/>
                        <Button Content="Beam Design" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#FFA726"
                                BorderBrush="#FFA726" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="design beam 6m span 15kn"/>
                    </WrapPanel>
                    <!-- Intelligence -->
                    <WrapPanel Margin="0,2">
                        <TextBlock Text="AI:" FontSize="10" FontWeight="SemiBold" Width="52"
                                   Foreground="{StaticResource FgSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Ask Experts" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#AB47BC"
                                BorderBrush="#AB47BC" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="ask experts review design"/>
                        <Button Content="Optimize Cost" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#AB47BC"
                                BorderBrush="#AB47BC" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="optimize cost"/>
                        <Button Content="Auto Params" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#AB47BC"
                                BorderBrush="#AB47BC" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="auto populate parameters"/>
                    </WrapPanel>
                    <!-- Query -->
                    <WrapPanel Margin="0,2">
                        <TextBlock Text="Query:" FontSize="10" FontWeight="SemiBold" Width="52"
                                   Foreground="{StaticResource FgSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="Summary" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#26C6DA"
                                BorderBrush="#26C6DA" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="model summary"/>
                        <Button Content="Health" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#26C6DA"
                                BorderBrush="#26C6DA" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="check health"/>
                        <Button Content="Walls" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#26C6DA"
                                BorderBrush="#26C6DA" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="walls"/>
                        <Button Content="Rooms" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#26C6DA"
                                BorderBrush="#26C6DA" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="rooms"/>
                        <Button Content="Count" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="#26C6DA"
                                BorderBrush="#26C6DA" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="count elements"/>
                        <Button Content="Help" Margin="2,1" Padding="8,3"
                                Background="{StaticResource CardBrush}" Foreground="{StaticResource FgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                FontSize="10" Cursor="Hand" Click="QuickAction_Click" Tag="help"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Text Input -->
                <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="4">
                    <Grid>
                        <TextBox x:Name="InputTextBox"
                                 Background="Transparent" Foreground="{StaticResource FgBrush}"
                                 CaretBrush="{StaticResource FgBrush}"
                                 BorderThickness="0" Padding="10,8" FontSize="13"
                                 AcceptsReturn="False" TextWrapping="Wrap" MaxLines="3"
                                 VerticalContentAlignment="Center"
                                 KeyDown="InputTextBox_KeyDown"
                                 TextChanged="InputTextBox_TextChanged"/>
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Type a message..."
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource PlaceholderBrush}"
                                   VerticalAlignment="Center" Margin="12,0"
                                   FontSize="13"/>
                    </Grid>
                </Border>

                <!-- Send Button -->
                <Button Grid.Column="1" x:Name="SendButton"
                        Width="36" Height="36" Margin="6,0,0,0"
                        Background="{StaticResource AccentBrush}"
                        BorderThickness="0" Cursor="Hand"
                        IsEnabled="False"
                        Click="SendButton_Click"
                        ToolTip="Send message (Enter)">
                    <Path Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"
                          Fill="White" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource HeaderBrush}" Padding="10,4">
            <TextBlock x:Name="StatusBarText" Text="StingBIM AI v7.0 | Type a message or click a quick action"
                       FontSize="10" Foreground="{StaticResource FgSecondaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
